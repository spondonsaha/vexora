# ---------------------------------------------------------------------------
# Runtime / database
# ---------------------------------------------------------------------------
POSTGRES_USER=recon
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=recon
DATABASE_URL=postgres://recon:change_me_in_production@db:5432/recon?sslmode=disable

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8080
API_ENV=development
# Comma-separated list of allowed CORS origins for local dev (client runs on 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ---------------------------------------------------------------------------
# Outbound tool guardrails (§14)
# ---------------------------------------------------------------------------
DEFAULT_RATE_LIMIT_RPS=10
DEFAULT_TOOL_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Worker / tool images
# ---------------------------------------------------------------------------
SUBFINDER_IMAGE=projectdiscovery/subfinder:latest
AMASS_IMAGE=caffix/amass:latest
GAU_IMAGE=sxcurity/gau:latest
HTTPX_IMAGE=projectdiscovery/httpx:latest
# Self-built images (see tools/ and build-tools script)
ASSETFINDER_IMAGE=recon/assetfinder:latest
SUBLIST3R_IMAGE=recon/sublist3r:latest
FINDOMAIN_IMAGE=recon/findomain:latest
CT_IMAGE=recon/ct:latest
WAYBACKURLS_IMAGE=recon/waybackurls:latest
KATANA_IMAGE=projectdiscovery/katana:latest
DOMAIN_AUDIT_IMAGE=recon/domainaudit:latest
TAKEOVER_IMAGE=recon/takeover:latest
NUCLEI_IMAGE=recon/nuclei:latest
# SQL injection testing (sqlmap) — targets discovered parameterised endpoints
SQLMAP_IMAGE=recon/sqlmap:latest
# Network recon (netscan): subdomain IP resolution + port scan + service detection
DNSX_IMAGE=projectdiscovery/dnsx:latest
NAABU_IMAGE=projectdiscovery/naabu:latest
NMAP_IMAGE=instrumentisto/nmap:latest
WORKER_POLL_SECONDS=3
# Max containers a single workflow step runs in parallel (wildcard scrape step)
WORKFLOW_MAX_CONCURRENCY=3
# Amass enumeration. Active mode resolves discovered names, grabs certificates
# and maps netblocks/ASNs (far more coverage than passive), and sends light DNS
# traffic to the target — only run against engagements you are authorized for
# (§14, §16). Set to false to force passive-only.
AMASS_ENABLED=true
AMASS_ACTIVE=true
# Per-tool toggles for the subdomain + URL discovery steps
SUBFINDER_ENABLED=true
ASSETFINDER_ENABLED=true
SUBLIST3R_ENABLED=true
FINDOMAIN_ENABLED=true
CT_ENABLED=true
GAU_ENABLED=true
WAYBACKURLS_ENABLED=true
KATANA_ENABLED=true
# CNAME/reverse-DNS resolution + subdomain-takeover fingerprint matching
TAKEOVER_ENABLED=true
# Nuclei template scanning (XSS / CVE / takeover / misconfiguration templates)
NUCLEI_ENABLED=true
# Network recon: resolve subdomains, port scan unique IPs, fingerprint services
NETWORK_SCAN_ENABLED=true
# Cap how many subdomains a single netscan resolves (unique IPs port-scanned are capped separately)
NETWORK_MAX_HOSTS=5000
# SQL injection testing (sqlmap): cap how many target URLs a single run tests
SQLI_ENABLED=true
SQLI_MAX_TARGETS=10
# JavaScript recon (jsrecon): fetch discovered .js assets and extract secrets /
# endpoints / hosts. Cap how many JS files a single run downloads.
JSRECON_IMAGE=recon/jsrecon:latest
JSRECON_ENABLED=true
JSRECON_MAX_FILES=100
# Open redirect testing (openredirect): probes parameterised URLs for open
# redirects, client-side redirect sinks, header injection and reflected payloads.
OPENREDIRECT_IMAGE=recon/openredirect:latest
OPENREDIRECT_ENABLED=true
OPENREDIRECT_MAX_TARGETS=50
OPENREDIRECT_CANARY=evil.com

# ---------------------------------------------------------------------------
# Technology fingerprinting (httpx tech-detect, WhatWeb, CMSeeK, WPScan)
# ---------------------------------------------------------------------------
TECHNOLOGY_ENABLED=true
TECH_MAX_TARGETS=500
WHATWEB_IMAGE=recon/whatweb:latest
WPSCAN_IMAGE=recon/wpscan:latest
CMSEEK_IMAGE=recon/cmseek:latest
WHATWEB_ENABLED=true
WPSCAN_ENABLED=true
CMSEEK_ENABLED=true

# ---------------------------------------------------------------------------
# WHOIS / RDAP registration intel
# ---------------------------------------------------------------------------
WHOIS_ENABLED=true
WHOIS_RDAP_BASE=https://rdap.org
WHOIS_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# SSRF discovery + out-of-band (OOB) interaction service
# ---------------------------------------------------------------------------
SSRF_ENABLED=true
SSRF_MAX_TARGETS=25
SSRF_POLL_SECONDS=20
SSRF_REQUEST_TIMEOUT_SECONDS=10
SSRF_CONCURRENCY=6
# Worker -> oob service (internal Compose network)
OOB_SERVICE_URL=http://oob:8090
# Upstream Interactsh servers used by the oob service
OOB_SERVERS=oast.pro,oast.live,oast.site,oast.online,oast.fun,oast.me
OOB_TOKEN=
OOB_POLL_SECONDS=2

# ---------------------------------------------------------------------------
# MCP server (§13)
# ---------------------------------------------------------------------------
MCP_PORT=3001
# Optional bearer token. If set, MCP clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
